<?xml version="1.0"?>
<launch>

  <group ns="ns1">
    <node pkg="starros" type="driver_node" name="dome_driver" output="screen">
      <param name="config_path" value="/launch/config/Dome.yaml"/>
    </node>
  </group>

  <group ns="ns2">
    <node pkg="starros" type="driver_node" name="rfans_driver" output="screen">
      <param name="config_path" value="/launch/config/RFans.yaml"/>
    </node>
  </group>

  <!-- <group ns="ns3">
    <node pkg="starros" type="driver_node" name="ck128_driver" output="screen">
      <param name="config_path" value="/launch/config/CK128.yaml"/>
    </node>
  </group> -->

  <!-- <group ns="ns4">
    <node pkg="starros" type="driver_node" name="cfans_driver" output="screen">
      <param name="config_path" value="/launch/config/CFans.yaml"/>
    </node>
  </group> -->

  <node pkg="rviz" type="rviz" name="rviz" args=" -d $(find starros)/rviz/multiRviz.rviz" output="screen"/>

</launch>
